{
  "name": "dsh-deepseek-webchat",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek web chat panel with restored sign-in, Chinese UI, conversation import, and a deepseek_web_ask agent tool plus its built-in skill and prompt section.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingxingLi/dsh-deepseek-webchat.git"
  },
  "homepage": "https://github.com/qingxingLi/dsh-deepseek-webchat",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "webview",
    "electron"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "skills/**",
    "icon.svg"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
